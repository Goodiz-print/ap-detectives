---
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
---

<Base
  title="AP Détectives | Message envoyé"
  description="Votre message a bien été transmis à AP Détectives & Consulting."
  noindex
  cta={false}
>
  <section class="container-site max-w-2xl py-24 text-center">
    <h1 class="heading-display">Merci, votre message est envoyé</h1>
    <p class="mt-6 text-lg leading-8">
      Nous vous répondrons dans les meilleurs délais. Pour une demande urgente, vous pouvez nous
      joindre au <a href={site.phone.href} class="underline">{site.phone.display}</a>.
    </p>
    <p class="mt-10"><a href="/" class="btn-gold">Retour à l’accueil</a></p>
  </section>
</Base>
