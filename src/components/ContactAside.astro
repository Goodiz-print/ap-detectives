---
import { Image } from 'astro:assets';
import { site } from '../data/site';

interface Props {
  image: ImageMetadata;
  alt: string;
}

const { image, alt } = Astro.props;
---

<aside class="md:order-first md:text-right">
  <div class="overflow-hidden">
    <Image
      src={image}
      alt={alt}
      widths={[400, 700]}
      sizes="(min-width: 768px) 45vw, 100vw"
      loading="eager"
      fetchpriority="high"
      class="anim-kenburns h-64 w-full object-cover md:h-auto"
    />
  </div>
  <address class="mt-8 space-y-6 leading-7 not-italic" data-reveal-children>
    <p>
      <strong>Adresse ({site.address.note})</strong><br />
      {site.address.street}<br />
      {site.address.postalCode} {site.address.city.toUpperCase()}
    </p>
    <p>
      <strong>Téléphone</strong><br />
      <a href={site.phone.href} class="hover:underline">{site.phone.display}</a>
    </p>
    <p>
      <a href={site.linkedin} rel="noopener" class="inline-block text-gold-text transition duration-300 hover:-translate-y-1 hover:text-ink">
        <span class="sr-only">Profil LinkedIn de {site.owner}</span>
        <svg width="34" height="34" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5ZM3 9.75h4V21H3V9.75Zm6.5 0h3.8v1.6h.05c.53-1 1.83-1.9 3.75-1.9 4 0 4.9 2.5 4.9 6V21h-4v-4.9c0-1.4-.03-3.1-1.9-3.1s-2.1 1.4-2.1 3V21h-4V9.75Z"></path>
        </svg>
      </a>
    </p>
  </address>
</aside>
