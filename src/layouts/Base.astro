---
import '@fontsource/roboto/latin-400.css';
import '@fontsource/roboto/latin-400-italic.css';
import '@fontsource/roboto/latin-700.css';
import '@fontsource/italiana/latin-400.css';
import '@fontsource-variable/raleway/wght.css';
import '@fontsource-variable/lora/wght.css';
import '../styles/global.css';

import Seo from '../components/Seo.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CtaBand from '../components/CtaBand.astro';

interface Props {
  title: string;
  description: string;
  image?: string;
  noindex?: boolean;
  jsonLd?: Record<string, unknown>[];
  headerVariant?: 'default' | 'overlay';
  /** Bandeau jaune « En savoir plus » avant le pied de page. */
  cta?: boolean;
}

const { headerVariant = 'default', cta = true, ...seo } = Astro.props;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#252529" />
    <Seo {...seo} />
  </head>
  <body id="top">
    <a
      href="#contenu"
      class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-50 focus:bg-white focus:px-4 focus:py-2"
    >
      Aller au contenu
    </a>
    <Header variant={headerVariant} />
    <main id="contenu">
      <slot />
    </main>
    {cta && <CtaBand />}
    <Footer />
  </body>
</html>
